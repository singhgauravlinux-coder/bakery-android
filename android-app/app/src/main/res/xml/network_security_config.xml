<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http://) is only ever needed against the dev/uat overlays or the
  emulator's loopback to a local docker-compose stack — never against
  production, which is HTTPS-only (see the "production" flavor's
  API_BASE_URL in app/build.gradle.kts). Scoping cleartext to these three
  hosts means a build misconfigured to point somewhere else still fails
  closed instead of silently allowing plaintext traffic.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">dev.bakery.local</domain>
        <domain includeSubdomains="false">uat.bakery.local</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
